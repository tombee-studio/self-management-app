        </mxCell>
        <mxCell id="rule-4" value="5. 全期間は一覧のみ。spentAt/IDのカーソルで50件ずつ" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
