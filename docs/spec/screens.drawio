        <mxCell id="rule-5" value="6. 他端末で削除済みなら保存せず最新一覧を表示" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
