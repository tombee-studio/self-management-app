        </mxCell>
        <mxCell id="rule-0" value="1. 期間は開始日〜翌月開始日前日。暦月履歴を流用しない" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="190" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-1" value="2. 日数は時刻・夏時間を除いた暦日差。今日を含める" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="282" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-2" value="3. 日次目安=max(0,floor(残額/残日数))" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="374" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-3" value="4. 予測=floor(期間実績/経過日数×期間総日数)、最初3日間は警告なし" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="466" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-4" value="5. 通知は期間/閾値単位で各1回。拒否でも保存・集計継続" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="558" width="870" height="80" as="geometry" />
        </mxCell>
