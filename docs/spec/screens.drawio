        <mxCell id="rule-1" value="2. 全画面でSafeAreaとviewInsetsを考慮する" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
