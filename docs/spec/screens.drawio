        </mxCell>
        <mxCell id="contract-map" value="DDD / 契約対応&#10;PaymentIntegrationの腐敗防止層と台帳取り込みApplication&#10;PAY-C01, PAY-C02, PAY-C03, PAY-C04&#10;UIはApplication契約へ依存し、DBを直接更新しない。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF2FF;strokeColor=#6366F1;align=left;spacing=10;fontSize=13;" vertex="1" parent="1" link="features/payment-event-ingestion.md">
