        <mxCell id="rule-5" value="6. 明細タップはSCR-005。ページ失敗で既表示を消さない" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
