        </mxCell>
        <mxCell id="rule-4" value="5. 続けて入力は金額とメモだけクリア。他の指定値は保持" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="558" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-5" value="6. 明示削除は確認してAPI確定後に削除。スワイプ削除のみ5秒Undo" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
