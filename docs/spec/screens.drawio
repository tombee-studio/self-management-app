        <mxCell id="rule-0" value="1. 期間・キーワード・カテゴリ・記録元はAND、カテゴリ内OR" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="190" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-1" value="2. メモをNFKC・lowercase・trimして部分一致。200ms debounce" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
