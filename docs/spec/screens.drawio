        <mxCell id="spec-title" value="コンポーネント仕様・業務ルール" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#0F172A;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="130" width="880" height="45" as="geometry" />
        </mxCell>
        <mxCell id="rule-0" value="1. 起動・変更成功・復帰でAPI再取得。復帰は前回取得開始から5秒以上" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="190" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-1" value="2. 自動同期スイッチなし。明示更新で表示対象を取得" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="282" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-2" value="3. LambdaがDynamoDBへ状態・版・Receipt・イベントを原子的に保存" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="374" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-3" value="4. 競合は集約版CAS。古い版は409で入力を保持し最新版確認" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="466" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-4" value="5. 応答喪失は結果不明。同じrequestIdで再送して結果確認" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="558" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-5" value="6. 端末DB・Push/Pull・保留キュー・端末DB移行なし" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="650" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="errors" value="検証結果は未実施。文書doneは実機・実装の合格を意味しない。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="490" y="790" width="870" height="75" as="geometry" />
        </mxCell>
        <mxCell id="contract-map" value="契約: SYN-C08 RefreshRemoteData / SYN-C09 SendRemoteCommand / SYN-C10 ConfigureConnection / SYN-C06 ValidateCostConfiguration。端末DB・同期スイッチ・保留キューなし。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF2FF;strokeColor=#6366F1;align=left;spacing=10;fontSize=13;" vertex="1" parent="1" link="features/aws-cloud-database-sync.md">
          <mxGeometry x="490" y="900" width="870" height="125" as="geometry" />
