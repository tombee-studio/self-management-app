        <mxCell id="rule-3" value="4. 月変更は日付選択・ページカーソルを解除" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
