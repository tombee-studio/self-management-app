        <mxCell id="rule-0" value="1. 名称trim後1〜20grapheme、NFKC正規化名の同名を拒否" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
