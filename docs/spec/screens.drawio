        <mxCell id="spec-title" value="コンポーネント仕様・業務ルール" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#0F172A;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="490" y="130" width="880" height="45" as="geometry" />
        </mxCell>
        <mxCell id="rule-0" value="1. 日次範囲はローカル日界から翌日未満。UTCへ変換して検索" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="190" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-1" value="2. 合計と内訳は同じ明細集合を使用。0件は0円と追加導線" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="282" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-2" value="3. 日付は1970年以降・未来許可。支出日時降順、同時刻はID降順" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="374" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-3" value="4. 予算は家計期間、日次表示は暦日。ラベルで区別" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="466" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-4" value="5. 取得失敗は再試行。API取得失敗はメモリ内の直前表示に未更新を表示" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="558" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-5" value="6. 840以上は左にサマリー・右に明細/編集。削除は即時＋5秒Undo" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="650" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="errors" value="検証結果は未実施。文書doneは実機・実装の合格を意味しない。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
          <mxGeometry x="490" y="790" width="870" height="75" as="geometry" />
        </mxCell>
        <mxCell id="contract-map" value="DDD / 契約対応&#10;ExpenseLedgerの読み取りモデル（CQRSのQuery側）&#10;DASH-C01, DASH-C02&#10;UIはApplication契約へ依存し、DBを直接更新しない。" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#EEF2FF;strokeColor=#6366F1;align=left;spacing=10;fontSize=13;" vertex="1" parent="1" link="features/daily-expense-dashboard.md">
          <mxGeometry x="490" y="900" width="870" height="125" as="geometry" />
        </mxCell>
        <mxCell id="cloud-api-policy" value="API版3: 業務データはAWS API経由。端末DBなし。保存は確定応答後に成功。通信失敗は入力保持、結果不明は同じrequestIdで再送。" style="text;html=0;align=left;whiteSpace=wrap;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="1300" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
