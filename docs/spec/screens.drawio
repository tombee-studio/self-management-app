        <mxCell id="rule-0" value="1. 幅は現在の論理ピクセル。900単独閾値は採用しない" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
