        </mxCell>
        <mxCell id="rule-0" value="1. 金額1〜99,999,999。範囲外・ゼロ除算は保存不可、上限へ丸めない" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="190" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-1" value="2. 必須カテゴリ、1970年以降の日時（未来許可）、支払い方法5種" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="282" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-2" value="3. メモはtrim・改行を空白化後grapheme100字まで" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="374" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-3" value="4. 保存中は二重送信を抑止。成功前にフォームを閉じない" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
