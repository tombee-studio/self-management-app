          <mxGeometry x="490" y="130" width="880" height="45" as="geometry" />
        </mxCell>
        <mxCell id="rule-0" value="1. アプリ経路 iris://add-expense とAPI背景経路を分ける" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="190" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-1" value="2. 金額はJPY整数1〜99,999,999。通貨・日時不正は保存しない" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="282" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-2" value="3. 重複は外部ID、IDなしはsource・金額・店舗・180秒以内" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="374" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-3" value="4. API成功/重複200、不正400、保存失敗500" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="466" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-4" value="5. 通知拒否でも保存を継続。通知タップで対象明細編集" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="558" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rule-5" value="6. Google Pay等の追加アダプタは対象外。rawPayloadを保存しない" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#F8FAFC;strokeColor=#CBD5E1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="490" y="650" width="870" height="80" as="geometry" />
        </mxCell>
        <mxCell id="errors" value="検証結果は未実施。文書doneは実機・実装の合格を意味しない。" style="text;html=0;align=left;verticalAlign=middle;whiteSpace=wrap;overflow=hidden;fontSize=13;fontColor=#0F172A;" vertex="1" parent="1">
