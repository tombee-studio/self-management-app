        <!-- 非機能要件カード -->
        <mxCell id="b_card_common" value="【 予算設定・管理 非機能要件 】&#xa;1. 動的日次推奨額の即時性: 支出追加・修正時に 16ms 以内で本日の推奨残高を再計算し、ダッシュボードへ反映。&#xa;2. プライバシー最優先: 目標金額・生活収支情報は完全ローカル SQLite にのみ保存され、外部送信ゼロ。" style="rounded=1;whiteSpace=wrap;html=1;arcSize=4;fillColor=#F1F5F9;strokeColor=#94A3B8;align=left;spacingLeft=15;fontSize=12;fontColor=#1E293B;verticalAlign=top;spacingTop=10;" vertex="1" parent="b_1">
          <mxGeometry x="780" y="500" width="810" height="75" as="geometry" />
        </mxCell>

